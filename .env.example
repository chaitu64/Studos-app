# Public client values only. Never add SUPABASE_SERVICE_ROLE_KEY to Expo env.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY
# Set true only after migration 011 is deployed and live RLS/RPC checks pass.
EXPO_PUBLIC_CHAT_REQUESTS_ENABLED=false
